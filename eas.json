{
  "cli": {
    "version": ">= 7.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "ANDROID_ARCHITECTURES": "arm64-v8a"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "ANDROID_ARCHITECTURES": "arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "ANDROID_ARCHITECTURES": "armeabi-v7a,arm64-v8a"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
